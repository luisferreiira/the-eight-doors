[sub_resource type="StyleBoxEmpty" id="SemFundo"]

[node name="CenaHistoria" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme")
script = ExtResource("1")

; A seção narrativa cobre todo o viewport com preto.
[node name="Fundo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
