[node name="TextoComum" type="Label" parent="Quadros/Quadro3/Conteudo" index="0" unique_id=804922272]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_override_constants/line_spacing = -2
theme_override_font_sizes/font_size = 12
text = "Ao olhar para a página, você lembrou do instante em que tudo escureceu. Tentou largar o lápis, mas sua mão continuou escrevendo.

A caverna que você acabara de percorrer tinha sido feita com suas lembranças. Enquanto procurava uma saída lá dentro, seu corpo continuava no chão do túnel.

Quando encontrou a saída, conseguiu abrir a mão. O lápis caiu na pedra."
horizontal_alignment = 1
autowrap_mode = 3

[node name="TextoAelin" type="Label" parent="Quadros/Quadro3/Conteudo" index="1" unique_id=1599215027]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_override_constants/line_spacing = -2
theme_override_font_sizes/font_size = 12
text = "Você se aproximou da parede e leu os dois nomes. Eram os mesmos que tinha encontrado na lista do castelo. Seus pais haviam fechado as portas que o rei mandara abrir.

Na primeira página, abaixo da promessa, você escreveu:
Por vocês, eu vou derrubar o rei."
horizontal_alignment = 1
autowrap_mode = 3

[node name="TextoDorian" type="Label" parent="Quadros/Quadro3/Conteudo" index="2" unique_id=1328274908]
visible = false
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_override_constants/line_spacing = -2
theme_override_font_sizes/font_size = 12
text = "Na biblioteca, você tinha encontrado a ordem do seu pai. Agora sabia o que ele esperava ganhar ao abrir as portas.

Na primeira página, abaixo da promessa, você escreveu:
Vou contar o que você fez, pai. E vou tirar você do trono."
horizontal_alignment = 1
autowrap_mode = 3

