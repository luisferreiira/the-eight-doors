theme_override_constants/line_spacing = -2
theme_override_font_sizes/font_size = 14
text = "Você seguiu as marcas na rocha até avistar a luz da superfície.

Antes de subir, abriu o caderno para guardar o lápis. Sua mão estava parada. Mesmo assim, uma frase começou a aparecer no rodapé, traço por traço, numa letra que você não reconhecia."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

