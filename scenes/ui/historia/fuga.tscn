theme_override_font_sizes/font_size = 17
text = "A última noite da guerra"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Texto" type="Label" parent="Quadros/Quadro2" index="1" unique_id=1502417229]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = 96.0
offset_bottom = 33.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/line_spacing = -2
theme_override_font_sizes/font_size = 12
text = "O rei abriu as portas por ordem própria. Buscava uma magia com a qual pudesse tirar de qualquer pessoa o poder de lhe dizer não. Os primeiros ataques começaram naquela mesma noite.

Na última noite da guerra, dois dos nossos lançaram um feitiço para fechar as oito passagens de uma só vez. O esforço consumiu as forças dos dois. Vi quando foram arrastados para o outro lado, pouco antes de a última porta se fechar. Nenhum deles voltou.

O feitiço ainda iluminava a pedra quando deixei a caverna. A luz foi enfraquecendo aos poucos, até sumir. Ao amanhecer, os ataques haviam cessado.

Deixo aqui os nomes dos dois."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

