offset_top = 96.0
theme_override_constants/line_spacing = -2
theme_override_font_sizes/font_size = 14
text = "Você abriu os olhos no chão, diante da inscrição. O lápis estava caído junto à parede, com a ponta gasta.

No caderno, havia uma página inteira escrita na sua letra. Você só se lembrava de ter escrito a data."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="Quadro2" type="Control" parent="Quadros" index="1" unique_id=1179249424]
