[node name="TextoAelin" type="Label" parent="Quadros/Quadro2/Conteudo" index="0" unique_id=1920616148]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_override_constants/line_spacing = -2
theme_override_font_sizes/font_size = 13
text = "Sob um nome falso, você aceitou um trabalho para o castelo. Sua tarefa era fazer desaparecer os documentos que ligavam o rei à guerra.

Entre os papéis, encontrou uma lista de quem havia descido aos túneis na última noite da batalha. Os nomes dos seus pais estavam ali. Até então, tudo o que você sabia era que eles tinham morrido naquela noite.

Você copiou o caminho até a entrada antes de entregar os papéis."
horizontal_alignment = 1
autowrap_mode = 3

[node name="TextoDorian" type="Label" parent="Quadros/Quadro2/Conteudo" index="1" unique_id=1959492552]
visible = false
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_override_constants/line_spacing = -2
theme_override_font_sizes/font_size = 13
text = "Na biblioteca do castelo, você encontrou uma ordem antiga escondida entre as páginas de um livro. Reconheceu a assinatura do seu pai. Ele mandava preparar a abertura das oito portas e manter os túneis sob guarda.

A ordem era anterior ao primeiro ataque. Você copiou a data e o caminho de acesso aos túneis. Queria descobrir o que seu pai esperava encontrar lá embaixo."
horizontal_alignment = 1
autowrap_mode = 3

